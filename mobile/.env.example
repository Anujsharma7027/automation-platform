#mobile.env
# Leave blank to use the Expo dev-server host automatically (works on emulator and device).
# To use a remote backend, set its reachable URL, e.g. https://api.example.com.
EXPO_PUBLIC_API_URL=
# Public OAuth client IDs (never put a client secret in the mobile app).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
