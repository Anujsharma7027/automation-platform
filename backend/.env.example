#backend.env
PORT=3000 
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/taskvyn

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Comma-separated Google OAuth client IDs for the web, Android, and iOS clients.
# Use the exact same client IDs configured in the mobile app environment.
GOOGLE_OAUTH_CLIENT_IDS=

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Taskvyn <onboarding@resend.dev>"

GOOGLE_CLIENT_ID=id
GOOGLE_CLIENT_SECRET=secret
GOOGLE_CALLBACK_URL=url

# Google token encryption
ENCRYPTION_KEY=key