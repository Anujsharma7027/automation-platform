#backend.env
PORT=3000 
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/taskvyn

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Comma-separated Google OAuth client IDs for the web, Android, and iOS clients.
# Use the exact same client IDs configured in the mobile app environment.
GOOGLE_OAUTH_CLIENT_IDS=

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Taskvyn <onboarding@resend.dev>"

# Google account connections for automations (Gmail, Sheets, Calendar, Drive, Forms).
# A "Web application" OAuth client, separate from the Taskvyn Sign-In client IDs.
# The old GOOGLE_GMAIL_* names still work as a fallback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/connections/google/callback
APP_MOBILE_REDIRECT_URI=mobile://oauth/gmail

# Redis for BullMQ queues (trigger polling + workflow execution). Use rediss:// for TLS.
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_PREFIX=taskvyn
# all = API + workers in one process, api = HTTP only, worker = background jobs only.
PROCESS_ROLE=all
TRIGGER_POLL_CONCURRENCY=10
WORKFLOW_RUN_CONCURRENCY=10

# Generate a random 32-byte key and base64-encode it. Keep the key outside Git.
OAUTH_TOKEN_ENCRYPTION_KEY_ID=development-v1
OAUTH_TOKEN_ENCRYPTION_KEY=
# Optional JSON map of older key IDs to base64 keys during a key rotation.
OAUTH_TOKEN_ENCRYPTION_PREVIOUS_KEYS={}
